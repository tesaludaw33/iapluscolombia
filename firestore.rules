rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }



    // Configuración visible de la tienda. Las escrituras pasan por Cloud Functions.
    match /settings/store {
      allow read: if true;
      allow write: if false;
    }

    // El usuario puede mantener únicamente su perfil básico. Los datos operativos
    // de subcolecciones los escribe el backend con Admin SDK.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['uid','displayName','email','photoURL','lastLoginAt']);
      allow update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['uid','displayName','email','photoURL','lastLoginAt']);
      allow delete: if false;

      // Las subcolecciones operativas se consultan a través de Cloud Functions.
      // Esto evita que registros heredados o campos internos queden expuestos
      // por una lectura directa desde el SDK del navegador.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Historial global de pedidos: el cliente solo consulta los suyos.
    match /orders/{orderId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Soporte: lectura del propietario o administrador; cambios por Functions.
    match /tickets/{ticketId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Colecciones sensibles: nunca se leen/escriben directamente desde el navegador.
    match /activationCodes/{code} {
      allow read, write: if false;
    }
    match /activationSecrets/{code} {
      allow read, write: if false;
    }
    match /coupons/{code} {
      allow read, write: if false;
    }
    match /referrals/{code} {
      allow read, write: if false;
    }
    match /adminSessions/{id} {
      allow read, write: if false;
    }
    match /adminAudit/{id} {
      allow read, write: if false;
    }
    match /adminClientMeta/{id} {
      allow read, write: if false;
    }
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
